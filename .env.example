# BugForge Configuration

# Application Settings
PROJECT_NAME="BugForge"
API_V1_STR="/api/v1"
DEBUG=True

# Backend Server Configuration
HOST="127.0.0.1"
PORT=8000

# Database Settings
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/bugforge
# SQLite fallback is automatic if postgresql database is unavailable
DATABASE_URL="sqlite:///./bugforge.db"

# AI Provider Settings
AI_PROVIDER="openai"  # Options: openai, anthropic, mock
AI_API_KEY=""
AI_MODEL="gpt-4o"

# Local Subprocess Execution Settings
RUNTIME_TIMEOUT=30
PYTHON_EXECUTABLE="python"
